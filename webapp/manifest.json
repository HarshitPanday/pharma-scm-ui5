{
 "_version": "1.58.0",
 "sap.app": {
  "id": "pharma.scm",
  "type": "application",
  "i18n": "i18n/i18n.properties",
  "title": "{{appTitle}}",
  "applicationVersion": {
   "version": "1.0.0"
  },
  "dataSources": {
   "mainService": {
    "uri": "/sap/opu/odata/sap/ZPHARMA_SRV/",
    "type": "OData",
    "settings": {
     "odataVersion": "2.0",
     "localUri": "localService/metadata.xml"
    }
   }
  }
 },
 "sap.ui": {
  "technology": "UI5",
  "deviceTypes": {
   "desktop": true,
   "tablet": true,
   "phone": true
  }
 },
 "sap.ui5": {
  "rootView": {
   "viewName": "pharma.scm.view.App",
   "type": "XML",
   "id": "app",
   "async": true
  },
  "dependencies": {
   "minUI5Version": "1.120.0",
   "libs": {
    "sap.ui.core": {},
    "sap.m": {},
    "sap.tnt": {},
    "sap.ui.layout": {},
    "sap.viz": {}
   }
  },
  "contentDensities": {
   "compact": true,
   "cozy": true
  },
  "models": {
   "i18n": {
    "type": "sap.ui.model.resource.ResourceModel",
"settings":{"bundleName":"pharma.scm.i18n.i18n","supportedLocales":[""],"fallbackLocale":""} 
  },
   "": {
    "dataSource": "mainService",
    "preload": true,
    "settings": {
     "defaultBindingMode": "OneWay",
     "useBatch": false
     
    }
   }
  },
  "resources": {
   "css": [
    {
     "uri": "css/style.css"
    }
   ]
  },
  "routing": {
   "config": {
    "routerClass": "sap.m.routing.Router",
    "type": "View",
    "viewType": "XML",
    "path": "pharma.scm.view",
    "controlId": "pageContainer",
    "controlAggregation": "pages",
    "async": true
   },
   "routes": [
    {
     "name": "dashboard",
     "pattern": "",
     "target": "dashboard"
    },
    {
     "name": "medicines",
     "pattern": "medicines",
     "target": "medicines"
    },
    {
     "name": "batches",
     "pattern": "batches",
     "target": "batches"
    },
    {
     "name": "purchase",
     "pattern": "purchase",
     "target": "purchase"
    },
    {
     "name": "inventory",
     "pattern": "inventory",
     "target": "inventory"
    },
    {
     "name": "warehouse",
     "pattern": "warehouse",
     "target": "warehouse"
    },
    {
     "name": "partners",
     "pattern": "partners",
     "target": "partners"
    },
    {
     "name": "sales",
     "pattern": "sales",
     "target": "sales"
    },
    {
     "name": "quality",
     "pattern": "quality",
     "target": "quality"
    },
    {
     "name": "reports",
     "pattern": "reports",
     "target": "reports"
    }
   ],
   "targets": {
    "dashboard": {
     "viewName": "Dashboard"
    },
    "medicines": {
     "viewName": "Medicines"
    },
    "batches": {
     "viewName": "Batches"
    },
    "purchase": {
     "viewName": "Purchase"
    },
    "inventory": {
     "viewName": "Inventory"
    },
    "warehouse": {
     "viewName": "Warehouse"
    },
    "partners": {
     "viewName": "Partners"
    },
    "sales": {
     "viewName": "Sales"
    },
    "quality": {
     "viewName": "Quality"
    },
    "reports": {
     "viewName": "Reports"
    }
   }
  }
 }
}