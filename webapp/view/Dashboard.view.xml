<mvc:View controllerName="pharma.scm.controller.Dashboard" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:viz="sap.viz.ui5.controls" xmlns:vd="sap.viz.ui5.data" xmlns:vf="sap.viz.ui5.controls.common.feeds"><Page title="Dashboard &amp; Analytics"><content><VBox width="100%" class="pageWrap"><FlexBox class="kpiGrid" items="{app>/kpis}"><VBox class="kpiCard" width="100%"><HBox justifyContent="SpaceBetween" alignItems="Center" width="100%"><Text text="{app>label}" class="kpiLabel"/><core:Icon src="{app>icon}" color="{app>iconColor}" size="1.25rem"/></HBox><ObjectNumber number="{app>value}" state="{app>state}" class="kpiValue"/><Text text="{app>sub}" class="kpiSub"/></VBox></FlexBox><FlexBox class="chartGrid"><Panel headerText="Monthly Purchase vs Sales (INR)" class="chartPanel"><viz:VizFrame id="vizPS" vizType="column" width="100%" height="300px"><viz:dataset><vd:FlattenedDataset data="{app>/charts/ps}"><vd:dimensions><vd:DimensionDefinition name="Month" value="{Month}"/></vd:dimensions><vd:measures><vd:MeasureDefinition name="Purchase" value="{Purchase}"/><vd:MeasureDefinition name="Sales" value="{Sales}"/></vd:measures></vd:FlattenedDataset></viz:dataset><viz:feeds><vf:FeedItem uid="categoryAxis" type="Dimension" values="Month"/><vf:FeedItem uid="valueAxis" type="Measure" values="Purchase,Sales"/></viz:feeds></viz:VizFrame></Panel><Panel headerText="Medicine Category Distribution (units)" class="chartPanel"><viz:VizFrame id="vizCat" vizType="donut" width="100%" height="300px"><viz:dataset><vd:FlattenedDataset data="{app>/charts/cat}"><vd:dimensions><vd:DimensionDefinition name="Category" value="{Category}"/></vd:dimensions><vd:measures><vd:MeasureDefinition name="Units" value="{Units}"/></vd:measures></vd:FlattenedDataset></viz:dataset><viz:feeds><vf:FeedItem uid="color" type="Dimension" values="Category"/><vf:FeedItem uid="size" type="Measure" values="Units"/></viz:feeds></viz:VizFrame></Panel><Panel headerText="Stock Movement Analysis (units)" class="chartPanel"><viz:VizFrame id="vizMov" vizType="line" width="100%" height="300px"><viz:dataset><vd:FlattenedDataset data="{app>/charts/mov}"><vd:dimensions><vd:DimensionDefinition name="Month" value="{Month}"/></vd:dimensions><vd:measures><vd:MeasureDefinition name="StockIn" value="{StockIn}"/><vd:MeasureDefinition name="StockOut" value="{StockOut}"/></vd:measures></vd:FlattenedDataset></viz:dataset><viz:feeds><vf:FeedItem uid="categoryAxis" type="Dimension" values="Month"/><vf:FeedItem uid="valueAxis" type="Measure" values="StockIn,StockOut"/></viz:feeds></viz:VizFrame></Panel><Panel headerText="Expiry Trend Analysis (units expiring)" class="chartPanel"><viz:VizFrame id="vizExp" vizType="column" width="100%" height="300px"><viz:dataset><vd:FlattenedDataset data="{app>/charts/exp}"><vd:dimensions><vd:DimensionDefinition name="Period" value="{Period}"/></vd:dimensions><vd:measures><vd:MeasureDefinition name="Units" value="{Units}"/></vd:measures></vd:FlattenedDataset></viz:dataset><viz:feeds><vf:FeedItem uid="categoryAxis" type="Dimension" values="Period"/><vf:FeedItem uid="valueAxis" type="Measure" values="Units"/></viz:feeds></viz:VizFrame></Panel></FlexBox><Table class="cardTable" items="{app>/fefo}" growing="true" growingThreshold="8"><headerToolbar><OverflowToolbar><Title text="Next to expire - FEFO pick order"/></OverflowToolbar></headerToolbar><columns><Column><Text text="Medicine"/></Column><Column><Text text="Pick"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Batch"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Expiry"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Warehouse"/></Column><Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Qty"/></Column></columns><items><ColumnListItem><cells><Text text="{app>Medicine}"/><ObjectStatus text="{app>Next}" state="Success"/><Text text="{app>BatchNo}"/><Text text="{app>Expiry}"/><Text text="{path:'app>Warehouse',formatter:'.fmt.wh'}"/><Text text="{app>Qty}"/></cells></ColumnListItem></items></Table></VBox></content></Page></mvc:View>