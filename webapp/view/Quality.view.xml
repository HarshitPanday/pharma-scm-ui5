<mvc:View controllerName="pharma.scm.controller.Quality" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc"><Page title="Quality Management - Inspection &amp; Release"><content><VBox width="100%" class="pageWrap"><Table class="cardTable" items="{path:'/Batches',sorter:{path:'ExpiryDate'}}" growing="true" growingThreshold="25" sticky="ColumnHeaders,HeaderToolbar"><headerToolbar><OverflowToolbar><Title text="Batch Quality Status"/><ToolbarSpacer/></OverflowToolbar></headerToolbar><columns><Column><Text text="Medicine"/></Column><Column><Text text="Batch No"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Expiry"/></Column><Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Qty"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="QC Status"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Action"/></Column></columns><items><ColumnListItem><cells><Text text="{parts:[{path:'MedicineId'},{path:'app>/lookup/med'}],formatter:'.fmt.name'}"/><Text text="{BatchNo}"/><Text text="{ExpiryDate}"/><Text text="{Quantity}"/><ObjectStatus text="{Status}" state="{path:'Status',formatter:'.fmt.state'}"/><HBox><Button text="Release" press=".onRelease" type="Accept" class="sapUiTinyMarginEnd" visible="{= ${Status} === 'Quarantine'}"/><Button text="Reject" press=".onReject" type="Reject" class="sapUiTinyMarginEnd" visible="{= ${Status} === 'Quarantine'}"/><Button text="Quarantine / Recall" press=".onHold" type="Default" class="sapUiTinyMarginEnd" visible="{= ${Status} === 'Released'}"/></HBox></cells></ColumnListItem></items></Table></VBox></content></Page></mvc:View>